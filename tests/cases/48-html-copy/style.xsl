<?xml version="1.0"?>
<!-- An HTML source copied to HTML output: attributes without a value stay
     without one, boolean ones are written bare, script stays raw. -->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="html"/>
  <xsl:template match="/"><xsl:copy-of select="."/></xsl:template>
</xsl:stylesheet>

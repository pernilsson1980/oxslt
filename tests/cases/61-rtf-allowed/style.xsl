<?xml version="1.0"?>
<!-- What a fragment may be used for: as a string, number or boolean, and (libxml2) in count(), sum(), the name functions, id(), key(), comparisons, copy-of, EXSLT set functions and exsl:node-set(); exsl:object-type tells it from a node-set. -->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:exsl="http://exslt.org/common" xmlns:set="http://exslt.org/sets" exclude-result-prefixes="exsl set"><xsl:output method="xml"/><xsl:key name="k" match="*" use="."/><xsl:variable name="r"><a id="i1">1</a><b>2</b></xsl:variable><xsl:template match="/"><out><xsl:value-of select="concat(string($r), number($r), boolean($r), count($r), sum($r), name($r), count(id($r)), count(key(&quot;k&quot;, $r)), count(set:distinct($r)), $r &lt; 13)"/>|<xsl:value-of select="concat(exsl:object-type($r), &quot; &quot;, exsl:object-type(exsl:node-set($r)))"/>|<xsl:value-of select="exsl:node-set($r)/a/@id"/>|<xsl:copy-of select="$r"/></out></xsl:template>
</xsl:stylesheet>
